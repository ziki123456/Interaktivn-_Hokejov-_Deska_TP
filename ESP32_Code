// --- POMOCNE FUNKCE ---

// Funkce vrátí true, pokud je právě stisknuté aspoň jedno tlačítko.
// Používám to třeba při čekání na uvolnění všech tlačítek.
bool anyButtonPressed() {
  return digitalRead(BTN_UP) == LOW || digitalRead(BTN_DOWN) == LOW || digitalRead(BTN_SEL) == LOW;
}

// Tato funkce čeká, dokud uživatel nepustí konkrétní tlačítko.
// Během čekání zároveň obsluhuje vypnutí tónu, aby zvuk nezůstal viset.
void waitForRelease(int pin) {
  while (digitalRead(pin) == LOW) {
    checkTone();
    delay(5);
  }
}

// Tato funkce čeká, dokud nejsou puštěná úplně všechna tlačítka.
void waitAllButtonsRelease() {
  while (anyButtonPressed()) {
    checkTone();
    delay(5);
  }
}

// Přepočet logických souřadnic hrací plochy x,y na fyzický index LED v pásku.
// Deska je zapojená hadovitě (serpentine), takže liché sloupce jsou obráceně.
// V každém sloupci je fyzicky 21 LED a herní body jsou po 4 LED.
int ledIndex(int x, int y) {
  return (x % 2 == 0) ? (x * 21 + y * 4) : (x * 21 + (5 - y) * 4);
}

// Přepočet logických souřadnic x,y na globální pin Hall senzoru přes MCP expandéry.
// Pole B a T obsahují spodní a horní kotvu každého sloupce.
// Prostřední expandér je zapojený obráceně, takže se to musí dopočítat tímto způsobem.
int hallGlobalPin(int x, int y) {
  static const int8_t B[] = {2, 13, 24, 23, 37, 45};
  static const int8_t T[] = {7, 8, 29, 18, 32, 40};
  return B[x] + y * ((T[x] > B[x]) ? 1 : -1);
}

// Krátké pípnutí přes buzzer.
// f = frekvence tónu, d = délka tónu v ms.
// Pokud je zapnutý tichý režim, funkce se hned ukončí.
void startBeep(int f, int d) {
  if (silentMode) return; // Pokud je ticho, hned skonči
  tone(BUZZER, f);
  stopToneTime = millis() + d;
}

// Kontrola, jestli už nemá být krátký tón vypnutý.
// Funguje to tak, že startBeep tón spustí a tahle funkce ho později vypne.
void checkTone() {
  if (stopToneTime > 0 && millis() >= stopToneTime) {
    noTone(BUZZER);
    stopToneTime = 0;
  }
}

// --- MELODIE POPCORN (VITEZNA) ---
// Tato funkce přehraje výherní melodii po vytvoření rekordu.
void playPopcorn() {
  int mel[] = {1319, 1175, 1319, 988, 784, 988, 659, 1319, 1175, 1319, 988, 784, 988, 659};
  int dur[] = {125, 125, 125, 125, 125, 125, 250, 125, 125, 125, 125, 125, 125, 250};

  for (int i = 0; i < 14; i++) {
    if(!silentMode) tone(BUZZER, mel[i], dur[i]);
    delay(dur[i] * 1.2);

    // Kdyby chtěl uživatel melodii přeskočit, může stisknout SELECT.
    if (digitalRead(BTN_SEL) == LOW) {
      noTone(BUZZER);
      break;
    }
  }

  noTone(BUZZER);
}

// --- MELODIE PRO PROHRU (STAR WARS - IMPERIAL MARCH) ---
// Tato funkce přehraje melodii při konci hry bez rekordu.
void playImperialMarch() {
  int mel[] = {440, 440, 440, 349, 523, 440, 349, 523, 440};
  int dur[] = {500, 500, 500, 350, 150, 500, 350, 150, 650};

  for (int i = 0; i < 9; i++) {
    if(!silentMode) tone(BUZZER, mel[i], dur[i]);
    delay(dur[i] * 1.1);

    if (digitalRead(BTN_SEL) == LOW) {
      noTone(BUZZER);
      break;
    }
  }

  noTone(BUZZER);
}

// --- ODPOCOVANI ---
// Společná funkce, která před spuštěním hry zobrazí 3, 2, 1, START!
void countdown() {
  strip.clear();
  strip.show();

  for (int i = 3; i > 0; i--) {
    tft.fillScreen(GC9A01A_BLACK);
    tft.setTextSize(8);
    tft.setTextColor(GC9A01A_YELLOW);
    tft.setCursor(95, 85);
    tft.print(i);

    if (!silentMode) tone(BUZZER, 800, 200);
    delay(1000);
  }

  tft.fillScreen(GC9A01A_BLACK);
  tft.setTextSize(5);
  tft.setTextColor(GC9A01A_GREEN);
  tft.setCursor(45, 100);
  tft.print("START!");
  if (!silentMode) tone(BUZZER, 1200, 400);
  delay(600);

  tft.fillScreen(GC9A01A_BLACK);
  strip.clear();
  strip.show();
}

// --- UI SYSTEM ---

// Pomocná funkce pro vykreslení oblouku z jednotlivých pixelů.
// Používám ji v menu pro indikaci tichého režimu.
void drawArc(int x, int y, int r, int startAngle, int endAngle, uint16_t color) {
  for (int i = startAngle; i <= endAngle; i++) {
    float rad = i * 3.14159 / 180.0;
    int px = x + cos(rad) * r;
    int py = y + sin(rad) * r;
    tft.drawPixel(px, py, color);
  }
}

// Vykreslení hlavního menu.
// Uprostřed je právě vybraná hra, nahoře a dole sousední položky.
// Zároveň se tu zobrazuje nejlepší výsledek pro danou hru.
